  "guard": [
    {
      "id": "git-push",
      "description": "원격 저장소로 push",
      "tools": [
        "Bash",
        "PowerShell"
      ],
      "allOf": [
        "\\bgit\\s+push\\b"
      ],
      "action": "ask"
    },
    {
      "id": "recursive-delete",
      "description": "폴더째 삭제 (rm -rf, Remove-Item -Recurse 등)",
      "tools": [
        "Bash",
        "PowerShell"
      ],
      "allOf": [
        "\\brm\\s+-[a-zA-Z]*[rR][a-zA-Z]*\\b|\\bRemove-Item\\b[^\\n]*-Recurse|\\brmdir\\s+/s|\\brd\\s+/s"
      ],
      "action": "ask"
    },
    {
      "id": "db-write",
      "description": "DB 직접 쓰기 (DB 드라이버 + 쓰기 SQL/commit이 한 명령에 같이 있으면)",
      "tools": [
        "Bash",
        "PowerShell"
      ],
      "allOf": [
        "pymysql|mysql\\.connector|mariadb\\.connect|psycopg2|sqlalchemy|\\bmysql\\b\\s+-|\\bmysqlsh\\b|\\bmariadb\\b\\s+-",
        "\\b(INSERT\\s+INTO|UPDATE\\s+\\w+\\s+SET|DELETE\\s+FROM|REPLACE\\s+INTO|CREATE\\s+(TABLE|INDEX|DATABASE)|ALTER\\s+TABLE|DROP\\s+(TABLE|DATABASE|INDEX)|TRUNCATE\\s+(TABLE\\s+)?\\w+)\\b|\\.commit\\s*\\("
      ],
      "action": "deny"
    },
    {
      "id": "db-dsn-bypass",
      "description": "조회 전용 스크립트에서 접속정보만 빼내는 우회",
      "tools": [
        "Bash",
        "PowerShell"
      ],
      "allOf": [
        "load_dsn|exec_module\\s*\\(.*sql"
      ],
      "action": "deny"
    }
  ],
  "rulesSync": [
    {
      "name": "쇼핑몰 v2 ← 쇼핑몰 규칙",
      "from": "C:\\work\\shop",
      "to": "C:\\work\\shop-v2",
      "files": [
        "frontend\\CLAUDE.md",
        "backend\\CLAUDE.md",
        "backend\\.claude\\rules\\common.md",
        "backend\\.claude\\settings.json"
      ],
      "header": [
        "> ⚠️ **쇼핑몰 v2 작업 공간용 쇼핑몰 규칙 사본입니다.** 이 파일을 직접 고치지 마세요.",
        "> 원본: `{src}` · 동기화: 마이오피스에서 `npm run rules:sync` ({date})"
      ]
    }
  ],
  "runner": {
    "maxConcurrent": 10,
    "model": "claude-opus-5-5",
    "idleMinutes": 15
  },
  "notifications": {
    "windows": {
      "enabled": true,
      "waiting": true,
      "error": true,
      "done": true,
      "doneQuietSeconds": 30,
      "denied": true
    },
    "mobile": null
  }
}
